{
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": "{color.slate.50}",
        "$description": "Body copy, headings, data."
      },
      "secondary": {
        "$value": "{color.slate.300}",
        "$description": "Supporting copy, table headers, meta."
      },
      "muted": {
        "$value": "{color.slate.400}",
        "$description": "Placeholders, timestamps. Still meets 4.5:1 on default and subtle surfaces."
      },
      "disabled": {
        "$value": "{color.slate.600}",
        "$description": "Disabled text. Exempt from WCAG 1.4.3 but always paired with a disabled container."
      },
      "inverse": {
        "$value": "{color.slate.900}",
        "$description": "Text on inverse surfaces (tooltips, toasts)."
      },
      "link": {
        "$value": "{color.blue.300}"
      },
      "link-hover": {
        "$value": "{color.blue.200}"
      }
    },
    "surface": {
      "app": {
        "$value": "{color.slate.975}",
        "$description": "Page/app background."
      },
      "default": {
        "$value": "{color.slate.950}",
        "$description": "Cards, tables, inputs."
      },
      "elevated": {
        "$value": "{color.slate.900}",
        "$description": "Menus, modals, sheets. In dark mode elevation is expressed by lightness."
      },
      "subtle": {
        "$value": "{color.slate.925}",
        "$description": "Table headers, search fields, off-hours calendar cells."
      },
      "selected": {
        "$value": "{color.blue.950}",
        "$description": "Selected rows, active nav items."
      },
      "inverse": {
        "$value": "{color.slate.100}"
      },
      "overlay": {
        "$value": "{color.black-alpha.72}",
        "$description": "Modal scrim."
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.slate.925}",
        "$description": "Dividers inside a surface. Decorative."
      },
      "default": {
        "$value": "{color.slate.850}",
        "$description": "Card and container edges. Decorative; containers are also separated by surface color."
      },
      "strong": {
        "$value": "{color.slate.500}",
        "$description": "Boundaries of interactive controls (inputs, checkboxes, chips). Meets 3:1 (WCAG 1.4.11)."
      },
      "hover": {
        "$value": "{color.slate.400}"
      },
      "focus": {
        "$value": "{color.blue.300}",
        "$description": "Focus ring color. Meets 3:1 against all surfaces."
      },
      "error": {
        "$value": "{color.red.400}"
      },
      "selected": {
        "$value": "{color.blue.400}"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$value": "{color.blue.400}"
        },
        "bg-hover": {
          "$value": "{color.blue.300}"
        },
        "bg-pressed": {
          "$value": "{color.blue.200}"
        },
        "fg": {
          "$value": "{color.blue.950}"
        }
      },
      "secondary": {
        "bg": {
          "$value": "{color.slate.950}"
        },
        "bg-hover": {
          "$value": "{color.blue.950}"
        },
        "bg-pressed": {
          "$value": "{color.blue.900}"
        },
        "fg": {
          "$value": "{color.blue.200}"
        },
        "border": {
          "$value": "{color.blue.400}"
        }
      },
      "tertiary": {
        "bg": {
          "$value": "{color.transparent}"
        },
        "bg-hover": {
          "$value": "{color.slate.900}"
        },
        "bg-pressed": {
          "$value": "{color.slate.850}"
        },
        "fg": {
          "$value": "{color.blue.300}"
        }
      },
      "destructive": {
        "bg": {
          "$value": "{color.red.400}"
        },
        "bg-hover": {
          "$value": "{color.red.300}"
        },
        "bg-pressed": {
          "$value": "{color.red.200}"
        },
        "fg": {
          "$value": "{color.red.950}"
        }
      }
    },
    "interaction": {
      "hover": {
        "$value": "{color.slate.900}",
        "$description": "Hover fill for rows, list items, ghost controls."
      },
      "pressed": {
        "$value": "{color.slate.850}"
      },
      "selected": {
        "bg": {
          "$value": "{color.blue.950}"
        },
        "fg": {
          "$value": "{color.blue.100}"
        },
        "border": {
          "$value": "{color.blue.400}"
        }
      },
      "focus": {
        "ring": {
          "$value": "{color.border.focus}"
        },
        "offset": {
          "$value": "{color.surface.default}",
          "$description": "Gap between control and ring so the ring reads on any fill."
        }
      },
      "disabled": {
        "bg": {
          "$value": "{color.slate.925}"
        },
        "fg": {
          "$value": "{color.text.disabled}"
        },
        "border": {
          "$value": "{color.slate.850}"
        }
      }
    },
    "status": {
      "$description": "Appointment statuses. Color is never the only cue: every status ships with a text label and a distinct icon (see $extensions).",
      "available": {
        "fg": {
          "$value": "{color.green.200}"
        },
        "bg": {
          "$value": "{color.green.950}"
        },
        "border": {
          "$value": "{color.green.800}"
        },
        "icon": {
          "$value": "{color.green.400}"
        },
        "$description": "Open slot a patient can book.",
        "$extensions": {
          "com.clearvisit": {
            "label": "Available",
            "icon": "calendar-plus"
          }
        }
      },
      "confirmed": {
        "fg": {
          "$value": "{color.blue.200}"
        },
        "bg": {
          "$value": "{color.blue.950}"
        },
        "border": {
          "$value": "{color.blue.800}"
        },
        "icon": {
          "$value": "{color.blue.400}"
        },
        "$description": "Booked and confirmed by practice and patient.",
        "$extensions": {
          "com.clearvisit": {
            "label": "Confirmed",
            "icon": "check-circle"
          }
        }
      },
      "pending": {
        "fg": {
          "$value": "{color.amber.200}"
        },
        "bg": {
          "$value": "{color.amber.950}"
        },
        "border": {
          "$value": "{color.amber.800}"
        },
        "icon": {
          "$value": "{color.amber.400}"
        },
        "$description": "Requested or held; awaiting confirmation. Rendered with dashed outline on calendars.",
        "$extensions": {
          "com.clearvisit": {
            "label": "Pending",
            "icon": "clock"
          }
        }
      },
      "completed": {
        "fg": {
          "$value": "{color.slate.200}"
        },
        "bg": {
          "$value": "{color.slate.900}"
        },
        "border": {
          "$value": "{color.slate.700}"
        },
        "icon": {
          "$value": "{color.slate.400}"
        },
        "$description": "Visit has happened. De-emphasised on purpose.",
        "$extensions": {
          "com.clearvisit": {
            "label": "Completed",
            "icon": "check-double"
          }
        }
      },
      "cancelled": {
        "fg": {
          "$value": "{color.red.200}"
        },
        "bg": {
          "$value": "{color.red.950}"
        },
        "border": {
          "$value": "{color.red.800}"
        },
        "icon": {
          "$value": "{color.red.400}"
        },
        "$description": "Cancelled by patient or practice. Time text is struck through.",
        "$extensions": {
          "com.clearvisit": {
            "label": "Cancelled",
            "icon": "x-circle"
          }
        }
      },
      "rescheduled": {
        "fg": {
          "$value": "{color.violet.200}"
        },
        "bg": {
          "$value": "{color.violet.950}"
        },
        "border": {
          "$value": "{color.violet.800}"
        },
        "icon": {
          "$value": "{color.violet.400}"
        },
        "$description": "Moved to a new time; links to the new appointment.",
        "$extensions": {
          "com.clearvisit": {
            "label": "Rescheduled",
            "icon": "arrow-path"
          }
        }
      }
    },
    "feedback": {
      "success": {
        "fg": {
          "$value": "{color.green.200}"
        },
        "bg": {
          "$value": "{color.green.950}"
        },
        "border": {
          "$value": "{color.green.800}"
        },
        "icon": {
          "$value": "{color.green.400}"
        },
        "$extensions": {
          "com.clearvisit": {
            "icon": "check-circle"
          }
        }
      },
      "warning": {
        "fg": {
          "$value": "{color.amber.200}"
        },
        "bg": {
          "$value": "{color.amber.950}"
        },
        "border": {
          "$value": "{color.amber.800}"
        },
        "icon": {
          "$value": "{color.amber.400}"
        },
        "$extensions": {
          "com.clearvisit": {
            "icon": "exclamation-triangle"
          }
        }
      },
      "error": {
        "fg": {
          "$value": "{color.red.200}"
        },
        "bg": {
          "$value": "{color.red.950}"
        },
        "border": {
          "$value": "{color.red.800}"
        },
        "icon": {
          "$value": "{color.red.400}"
        },
        "$extensions": {
          "com.clearvisit": {
            "icon": "exclamation-circle"
          }
        }
      },
      "info": {
        "fg": {
          "$value": "{color.blue.200}"
        },
        "bg": {
          "$value": "{color.blue.950}"
        },
        "border": {
          "$value": "{color.blue.800}"
        },
        "icon": {
          "$value": "{color.blue.400}"
        },
        "$extensions": {
          "com.clearvisit": {
            "icon": "information-circle"
          }
        }
      }
    },
    "accent": {
      "bg": {
        "$value": "{color.teal.950}"
      },
      "fg": {
        "$value": "{color.teal.200}"
      },
      "border": {
        "$value": "{color.teal.800}"
      },
      "solid": {
        "$value": "{color.teal.400}",
        "$description": "Graphic accents, the calendar 'now' line."
      }
    },
    "chart": {
      "series-1": {
        "$value": "{color.blue.400}"
      },
      "series-2": {
        "$value": "{color.teal.400}"
      },
      "series-3": {
        "$value": "{color.violet.400}"
      },
      "series-4": {
        "$value": "{color.amber.400}"
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Theme-aware elevation. Dark theme uses stronger shadows plus lighter surfaces.",
    "raised": {
      "$value": "{shadow.strong.1}"
    },
    "popover": {
      "$value": "{shadow.strong.2}"
    },
    "overlay": {
      "$value": "{shadow.strong.3}"
    }
  }
}
