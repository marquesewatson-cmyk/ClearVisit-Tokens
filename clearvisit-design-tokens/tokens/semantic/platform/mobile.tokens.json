{
  "size": {
    "control": {
      "$description": "Control heights. Mobile = touch-first, desktop = density-first.",
      "sm": {
        "$value": "{size.36}"
      },
      "md": {
        "$value": "{size.48}"
      },
      "lg": {
        "$value": "{size.56}"
      }
    },
    "touch-target": {
      "$value": "{size.48}",
      "$description": "Minimum hit area. Mobile 48 exceeds WCAG 2.5.8 (24) and matches platform HIG guidance; desktop uses the 24px AA minimum for pointer input."
    },
    "icon": {
      "sm": {
        "$value": "{size.16}"
      },
      "md": {
        "$value": "{size.24}"
      },
      "lg": {
        "$value": "{size.32}"
      }
    },
    "avatar": {
      "$value": "{size.56}"
    },
    "selection-control": {
      "$value": "{size.24}",
      "$description": "Checkbox/radio visual size (hit area is touch-target)."
    },
    "nav-bar": {
      "$value": "{size.64}",
      "$description": "Mobile bottom nav height / desktop top bar height."
    },
    "table-row": {
      "$value": "{size.56}"
    },
    "table-header": {
      "$value": "{size.48}"
    },
    "day-cell": {
      "$value": "{size.44}",
      "$description": "Date picker day."
    },
    "time-slot": {
      "$value": "{size.48}"
    },
    "modal-max": {
      "$value": "{size.600}"
    }
  },
  "space": {
