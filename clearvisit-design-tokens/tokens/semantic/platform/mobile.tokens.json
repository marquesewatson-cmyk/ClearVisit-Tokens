      },
      "page": {
        "$value": "{space.16}"
      }
    },
    "section": {
      "$value": "{space.24}"
    }
  },
  "radius": {
    "control": {
      "$value": "{radius.12}"
    },
    "card": {
      "$value": "{radius.16}"
    },
    "modal": {
      "$value": "{radius.24}",
      "$description": "Mobile modals render as bottom sheets (top corners only)."
    }
  },
  "layout": {
    "columns": {
      "$value": "{grid.columns.4}"
    },
    "gutter": {
      "$value": "{space.16}"
    },
    "margin": {
      "$value": "{space.16}"
    }
