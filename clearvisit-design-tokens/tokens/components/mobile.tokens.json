      "$value": "{color.status.available.icon}"
    },
    "unavailable-fg": {
      "$value": "{color.text.disabled}"
    }
  },
  "time-slot": {
    "$description": "Bookable time button. Selected = filled + check icon; booked = disabled fill + struck-through time + 'Booked' a11y label.",
