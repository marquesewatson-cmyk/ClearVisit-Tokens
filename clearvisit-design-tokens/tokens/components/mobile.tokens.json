    "bg": {
      "$value": "{color.surface.default}"
    },
    "border": {
      "$value": "{color.border.default}"
    },
    "radius": {
      "$value": "{radius.card}"
    },
    "padding": {
      "$value": "{space.inset.card}"
    },
    "slot-gap": {
      "$value": "{space.inline.sm}"
    },
    "time-style": {
      "$value": "{text-style.appointment-time}"
    }
  },
  "booking-card": {
    "bg": {
      "$value": "{color.surface.elevated}"
    },
    "radius": {
      "$value": "{radius.card}"
    },
    "padding": {
      "$value": "{space.inset.card}"
    },
    "shadow": {
      "$value": "{elevation.popover}"
