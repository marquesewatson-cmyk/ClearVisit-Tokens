      "$value": "{radius.control}"
    },
    "gap": {
      "$value": "{space.inline.sm}"
    },
    "text-style": {
      "$value": "{text-style.button}"
    },
    "bg": {
      "$value": "{color.surface.default}"
    },
    "fg": {
      "$value": "{color.action.secondary.fg}"
    },
    "border": {
      "$value": "{color.border.strong}"
    },
    "bg-hover": {
      "$value": "{color.action.secondary.bg-hover}"
    },
    "selected-bg": {
      "$value": "{color.action.primary.bg}"
    },
    "selected-fg": {
      "$value": "{color.action.primary.fg}"
    },
    "disabled-bg": {
      "$value": "{color.interaction.disabled.bg}"
    },
    "disabled-fg": {
      "$value": "{color.interaction.disabled.fg}"
    },
    "disabled-border": {
      "$value": "{color.interaction.disabled.border}"
    }
